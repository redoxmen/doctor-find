# Application Environment
NODE_ENV="development"
PORT=3000

# Synthetic Demonstration Mode Flag (Enforces simulated test vectors only)
DEMO_SYNTHETIC_DATA_ONLY="true"

# Hospital Node Identifier for mTLS Federation
HOSPITAL_NODE_ID="HOSP-01-CITYGENERAL"

# Optional Gemini API Key for SecOps Plain-English Explanations
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Hosted App URL
APP_URL="MY_APP_URL"
